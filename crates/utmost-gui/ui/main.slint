import { VerticalBox, HorizontalBox, ListView, ProgressIndicator } from "std-widgets.slint";
import { DetailPage, FilterChipData, FileTileData, MetadataRow, VariantThumbData, NoteRowData, GroupTabData } from "detail.slint";
import { Lightbox } from "lightbox.slint";
import { VariantViewer } from "variant_viewer.slint";

export { FilterChipData, FileTileData, MetadataRow, VariantThumbData, NoteRowData, GroupTabData }

export struct SourceRowData {
    source_id: int,
    filename: string,
    files_found: int,
    progress: float,
    status: string,
}

export struct CaseRowData {
    case_id: int,
    source_basename: string,
    source_path: string,
    status: string,
    files_found: int,
    elapsed: string,
    progress: float,
    clickable: bool,
}

export component MainWindow inherits Window {
    title: "utmost";
    preferred-width: 900px;
    preferred-height: 600px;

    in-out property <[SourceRowData]> sources: [];
    in-out property <string> run-status: "Pending";
    in-out property <int> total-files: 0;
    in-out property <string> elapsed: "0s";

    in property <bool> indexing-active: false;
    in property <int> indexing-files: 0;
    in property <float> indexing-progress: 0.0;

    // Task 14: windowed-grid bridge. `total-rows` is written from Rust each
    // sync; `grid-cols` is computed by Slint from the pane width and
    // propagated UP via the `grid-cols-changed` callback (DetailPage fires
    // it on both `init` and `changed`, so the initial layout value reaches
    // Rust without needing a user resize). `grid-viewport-y` is propagated
    // UP from the DetailPage's Flickable so Rust can compute the visible
    // row range and slide the window when needed. `requery-active` is
    // reserved for a requery-in-progress overlay (used in later tasks).
    in property <int> total-rows: 0;
    in-out property <int> grid-cols: 1;
    in-out property <length> grid-viewport-y: 0px;
    in property <bool> requery-active: false;
    callback grid-cols-changed(int);

    in-out property <bool> show-detail: false;
    in-out property <[FilterChipData]> chips: [];
    in-out property <[GroupTabData]> group-chips: [];
    in-out property <bool> filters-visible: true;
    in-out property <bool> bookmarked-filter-enabled: false;
    in-out property <bool> hide-no-preview-enabled: false;

    in-out property <[string]> sort-key-items: ["Filename", "Size", "File type", "Source offset"];
    in-out property <int> sort-key-index: 0;
    in-out property <bool> sort-dir-asc: true;
    in-out property <bool> bookmarked-first-enabled: false;

    in-out property <float> size-lo-norm: 0.0;
    in-out property <float> size-hi-norm: 1.0;
    in-out property <string> size-range-label: "";
    in-out property <string> size-max-label: "";
    in-out property <bool> size-slider-visible: false;

    callback size-range-changed(float, float);

    in-out property <[FileTileData]> tiles: [];
    in-out property <[MetadataRow]> selected-metadata: [];
    in-out property <bool> side-panel-open: false;
    in-out property <string> selected-filename: "";
    in-out property <bool> selected-has-preview: false;
    in-out property <image> selected-preview;

    in-out property <bool> selected-bookmarked: false;
    in-out property <[NoteRowData]> selected-notes: [];
    in-out property <string> note-draft: "";
    in-out property <[VariantThumbData]> selected-variants: [];
    in-out property <bool> selected-has-variants: false;
    in-out property <bool> recovery-button-visible: false;
    in-out property <bool> recovery-button-enabled: true;
    in-out property <string> recovery-button-label: "Run recovery";
    in-out property <int> keep-candidates: 5;
    // -1 = no tile selected
    in-out property <int> selected-id: -1;

    in-out property <bool> lightbox-open: false;
    in-out property <bool> lightbox-has-image: false;
    in-out property <image> lightbox-image;
    in-out property <string> lightbox-filename: "";
    in-out property <int> lightbox-index1: 0;
    in-out property <int> lightbox-total: 0;
    in-out property <float> lightbox-zoom: 1.0;
    in-out property <bool> lightbox-fit: true;
    in-out property <bool> lightbox-bookmarked: false;
    in-out property <bool> lightbox-mark-best-visible: false;
    in-out property <bool> lightbox-note-input-open: false;
    in-out property <string> lightbox-note-draft: "";

    in property <[CaseRowData]> cases: [];
    in-out property <int> picker-selected-index: -1;
    callback case-clicked(int);
    callback back-to-picker();

    callback row-clicked(int);
    callback chip-toggled(string);
    callback group-tab-clicked(string);
    callback filters-toggle();
    callback bookmarked-filter-toggle();
    callback hide-no-preview-toggle();

    callback sort-key-changed(int);
    callback sort-dir-toggle();
    callback bookmarked-first-toggle();

    callback gallery-nav(string, int);
    callback select-all();
    callback select-none();
    callback tile-clicked(int);
    callback tile-double-clicked(int);
    callback tile-enter-pressed();
    callback detail-escape-pressed();
    callback back-clicked();
    callback large-preview-clicked();
    callback side-panel-close();
    callback grid-background-clicked();
    callback toggle-bookmark();
    callback add-note(string);
    callback open-variant-viewer();
    callback variant-thumb-clicked(int);
    callback variant-thumb-double-clicked(int);
    callback run-recovery();
    callback lightbox-close();
    callback lightbox-next();
    callback lightbox-prev();
    callback lightbox-zoom-changed(float);
    callback lightbox-zoom-fit();
    callback lightbox-toggle-bookmark();
    callback lightbox-add-note(string);
    callback lightbox-mark-best();

    in-out property <bool> variant-viewer-open: false;
    in-out property <string> variant-viewer-filename: "";
    in-out property <[VariantThumbData]> variant-viewer-variants: [];

    callback variant-viewer-close();
    callback variant-viewer-thumb-clicked(int);
    callback variant-viewer-thumb-double-clicked(int);

    if root.show-detail: DetailPage {
        width: parent.width;
        height: parent.height;
        indexing-active: root.indexing-active;
        indexing-files: root.indexing-files;
        indexing-progress: root.indexing-progress;
        // Task 14: windowed-grid plumbing.
        total-rows: root.total-rows;
        grid-cols: root.grid-cols;
        requery-active: root.requery-active;
        grid-cols-changed(c) => {
            root.grid-cols = c;
            root.grid-cols-changed(c);
        }
        // Mirror the DetailPage's grid-viewport-y up to the MainWindow's
        // out property each frame. Bound via a callback (one-way: DetailPage
        // -> MainWindow) since Slint's `out` -> `out` direct binding rules
        // are restrictive across nested components.
        changed grid-viewport-y => {
            root.grid-viewport-y = self.grid-viewport-y;
        }
        chips: root.chips;
        group-chips: root.group-chips;
        filters-visible: root.filters-visible;
        bookmarked-filter-enabled: root.bookmarked-filter-enabled;
        hide-no-preview-enabled: root.hide-no-preview-enabled;
        sort-key-items: root.sort-key-items;
        sort-key-index: root.sort-key-index;
        sort-dir-asc: root.sort-dir-asc;
        bookmarked-first-enabled: root.bookmarked-first-enabled;
        size-lo-norm: root.size-lo-norm;
        size-hi-norm: root.size-hi-norm;
        size-range-label: root.size-range-label;
        size-max-label: root.size-max-label;
        size-slider-visible: root.size-slider-visible;
        size-range-changed(lo, hi) => {
            root.size-range-changed(lo, hi);
        }
        tiles: root.tiles;
        selected-metadata: root.selected-metadata;
        side-panel-open: root.side-panel-open;
        selected-filename: root.selected-filename;
        selected-has-preview: root.selected-has-preview;
        selected-preview: root.selected-preview;
        selected-bookmarked: root.selected-bookmarked;
        selected-notes: root.selected-notes;
        note-draft: root.note-draft;
        selected-variants: root.selected-variants;
        selected-has-variants: root.selected-has-variants;
        recovery-button-visible: root.recovery-button-visible;
        recovery-button-enabled: root.recovery-button-enabled;
        recovery-button-label: root.recovery-button-label;
        keep-candidates: root.keep-candidates;
        selected-id: root.selected-id;
        chip-toggled(n) => {
            root.chip-toggled(n);
        }
        group-tab-clicked(name) => {
            root.group-tab-clicked(name);
        }
        filters-toggle => {
            root.filters-toggle();
        }
        bookmarked-filter-toggle => {
            root.bookmarked-filter-toggle();
        }
        hide-no-preview-toggle => {
            root.hide-no-preview-toggle();
        }
        sort-key-changed(idx) => {
            root.sort-key-changed(idx);
        }
        sort-dir-toggle => {
            root.sort-dir-toggle();
        }
        bookmarked-first-toggle => {
            root.bookmarked-first-toggle();
        }
        gallery-nav(dir, cols) => {
            root.gallery-nav(dir, cols);
        }
        select-all => {
            root.select-all();
        }
        select-none => {
            root.select-none();
        }
        tile-clicked(id) => {
            root.tile-clicked(id);
        }
        tile-double-clicked(id) => {
            root.tile-double-clicked(id);
        }
        tile-enter-pressed => {
            root.tile-enter-pressed();
        }
        detail-escape-pressed => {
            root.detail-escape-pressed();
        }
        back => {
            root.back-clicked();
        }
        large-preview-clicked => {
            root.large-preview-clicked();
        }
        side-panel-close => {
            root.side-panel-close();
        }
        grid-background-clicked => {
            root.grid-background-clicked();
        }
        toggle-bookmark => {
            root.toggle-bookmark();
        }
        add-note(text) => {
            root.add-note(text);
        }
        open-variant-viewer => {
            root.open-variant-viewer();
        }
        variant-thumb-clicked(id) => {
            root.variant-thumb-clicked(id);
        }
        variant-thumb-double-clicked(id) => {
            root.variant-thumb-double-clicked(id);
        }
        run-recovery => {
            root.run-recovery();
        }
    }

    if !root.show-detail: VerticalBox {
        spacing: 0px;
        Rectangle {
            height: 32px;
            background: #1f2937;
            Text {
                text: "utmost — select a case";
                color: white;
                vertical-alignment: center;
                x: 12px;
            }
        }
        ListView {
            // TODO: spec requires tooltip on hover for Corrupt rows; Slint TouchArea
            // lacks a native tooltip, so this is deferred until a hover-overlay pattern
            // is added (or the spec is relaxed).
            for c[i] in root.cases : Rectangle {
                height: 56px;
                background: c.clickable
                    ? (root.picker-selected-index == i
                        ? #2a3441
                        : (touch.has-hover ? #1e2a36 : transparent))
                    : #14181f;
                Rectangle {
                    x: 12px;
                    y: 0px;
                    width: parent.width - 24px;
                    height: parent.height;
                    HorizontalBox {
                        alignment: stretch;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: c.source-basename;
                                color: c.clickable ? white : #6b7280;
                                font-size: 14px;
                            }
                            Text {
                                text: c.source-path;
                                color: #6b7280;
                                font-size: 11px;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: c.files-found + " files";
                            color: c.clickable ? #9ca3af : #4b5563;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: c.elapsed;
                            color: c.clickable ? #9ca3af : #4b5563;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: c.status;
                            color: c.status == "Running" ? #10b981 : (c.status == "Corrupt" ? #ef4444 : #9ca3af);
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    if c.progress > 0 && c.progress < 1 : Rectangle {
                        y: parent.height - 2px;
                        height: 2px;
                        width: parent.width * c.progress;
                        background: #10b981;
                    }
                }
                touch := TouchArea {
                    enabled: c.clickable;
                    clicked => {
                        root.picker-selected-index = i;
                        root.case-clicked(c.case-id);
                    }
                }
            }
        }
    }

    if root.lightbox-open: Lightbox {
        width: parent.width;
        height: parent.height;
        has-image: root.lightbox-has-image;
        source-image: root.lightbox-image;
        filename: root.lightbox-filename;
        index1: root.lightbox-index1;
        total: root.lightbox-total;
        zoom: root.lightbox-zoom;
        fit: root.lightbox-fit;
        caption: "(no preview)";
        lightbox-bookmarked: root.lightbox-bookmarked;
        lightbox-mark-best-visible: root.lightbox-mark-best-visible;
        lightbox-note-input-open: root.lightbox-note-input-open;
        lightbox-note-draft: root.lightbox-note-draft;
        init => {
            self.focus();
        }
        close => {
            root.lightbox-close();
        }
        nav-next => {
            root.lightbox-next();
        }
        nav-prev => {
            root.lightbox-prev();
        }
        zoom-changed(v) => {
            root.lightbox-zoom-changed(v);
        }
        zoom-fit => {
            root.lightbox-zoom-fit();
        }
        lightbox-toggle-bookmark => {
            root.lightbox-toggle-bookmark();
        }
        lightbox-add-note(text) => {
            root.lightbox-add-note(text);
        }
        lightbox-mark-best => {
            root.lightbox-mark-best();
        }
    }

    VariantViewer {
        visible-flag: root.variant-viewer-open;
        source-filename: root.variant-viewer-filename;
        variants: root.variant-viewer-variants;
        close => { root.variant-viewer-close(); }
        variant-clicked(id) => { root.variant-viewer-thumb-clicked(id); }
        variant-double-clicked(id) => { root.variant-viewer-thumb-double-clicked(id); }
        width: parent.width;
        height: parent.height;
    }
}
