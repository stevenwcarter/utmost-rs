import { HorizontalBox, VerticalBox, Button, SpinBox, LineEdit, TextEdit, ComboBox, ProgressIndicator } from "std-widgets.slint";
import { RangeSlider } from "range_slider.slint";

export struct FilterChipData {
    name: string,
    display_name: string,
    enabled: bool,
    count: int,
    kind: string,  // "type" | "partial" | "bookmarked"
}

export struct FileTileData {
    id: int,
    filename: string,
    filesize: string,
    file_type: string,
    has_thumbnail: bool,
    thumbnail: image,
    absolute_row: int,
    absolute_col: int,
    is_bookmarked: bool,
}

export struct MetadataRow {
    key: string,
    value: string,
}

export struct VariantThumbData {
    file_id: int,
    rank: int,
    has_thumbnail: bool,
    thumbnail: image,
    is_best: bool,
}

export struct GroupTabData {
    name: string,
    display_name: string,
    active_count: int,
    is_selected: bool,
}

export struct NoteRowData {
    note_id: int,
    text: string,
    at: string,
}

export component LargePreview inherits Rectangle {
    in property <bool> has-image: false;
    in property <image> source-image;
    in property <string> caption: "";

    background: #0a0a0a;
    border-color: #2a2a2a;
    border-width: 1px;

    if root.has-image: Image {
        source: root.source-image;
        width: parent.width - 8px;
        height: parent.height - 8px;
        x: 4px;
        y: 4px;
        image-fit: contain;
    }

    if !root.has-image: Text {
        text: root.caption;
        color: #888;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

export component DetailPage inherits Rectangle {
    in-out property <[FilterChipData]> chips: [];
    in-out property <[FileTileData]> tiles: [];
    in-out property <string> sort-key: "Filename";
    in-out property <string> sort-dir: "Asc";

    in-out property <[MetadataRow]> selected-metadata: [];
    in-out property <bool> side-panel-open: false;
    in-out property <string> selected-filename: "";
    in-out property <bool> selected-has-preview: false;
    in-out property <image> selected-preview;

    in property <bool> indexing-active: false;
    in property <int> indexing-files: 0;
    in property <float> indexing-progress: 0.0;

    // Task 14: windowed grid plumbing.
    //
    // The Slint Flickable acts as a viewport over a virtual grid that is
    // `total-rows` tall. The Rust side keeps only a sliding window of rows
    // in `vm.window` and tiles include their `absolute_row` / `absolute_col`
    // so they position correctly within the full grid.
    in property <int> total-rows: 0;
    in property <int> grid-cols: 1;
    out property <length> grid-viewport-y: 0px;
    in property <bool> requery-active: false;
    callback grid-cols-changed(int);

    in-out property <bool> selected-bookmarked: false;
    in-out property <[NoteRowData]> selected-notes: [];
    in-out property <string> note-draft: "";
    in-out property <[VariantThumbData]> selected-variants: [];
    in-out property <bool> selected-has-variants: false;
    in-out property <bool> recovery-button-visible: false;
    in-out property <bool> recovery-button-enabled: true;
    in-out property <string> recovery-button-label: "Run recovery";
    in-out property <int> keep-candidates: 5;
    // -1 = no tile selected
    in-out property <int> selected-id: -1;

    in-out property <[GroupTabData]> group-chips: [];
    in-out property <bool> filters-visible: true;
    in-out property <bool> bookmarked-filter-enabled: false;
    in-out property <bool> hide-no-preview-enabled: false;

    in-out property <[string]> sort-key-items: ["Filename", "Size", "File type", "Source offset"];
    in-out property <int> sort-key-index: 0;
    in-out property <bool> sort-dir-asc: true;
    in-out property <bool> bookmarked-first-enabled: false;

    in-out property <float> size-lo-norm: 0.0;
    in-out property <float> size-hi-norm: 1.0;
    in-out property <string> size-range-label: "";
    in-out property <string> size-max-label: "";
    in-out property <bool> size-slider-visible: false;

    callback size-range-changed(float, float);

    // Toggled by the 'n' key handler to signal note_input to grab focus.
    // Slint does not permit cross-scope focus calls (the outer FocusScope
    // cannot call note_input.focus() directly), so we toggle this flag and
    // note_input observes the change to focus itself.
    private property <bool> note-focus-pulse: false;
    // Mirrors note_input.has-focus via a `changed has-focus` handler inside
    // the conditional block — the only way to observe a conditionally-
    // instantiated element's focus state from the outer FocusScope.
    private property <bool> note-editor-focused: false;

    callback toggle-bookmark();
    callback add-note(string);
    callback open-variant-viewer();
    callback variant-thumb-clicked(int);
    callback variant-thumb-double-clicked(int);
    callback run-recovery();

    callback group-tab-clicked(string);
    callback filters-toggle();
    callback bookmarked-filter-toggle();
    callback hide-no-preview-toggle();

    callback sort-key-changed(int);
    callback sort-dir-toggle();
    callback bookmarked-first-toggle();

    callback chip-toggled(string);
    callback gallery-nav(string, int);
    callback select-all();
    callback select-none();
    callback tile-clicked(int);
    callback tile-double-clicked(int);
    callback tile-enter-pressed();
    callback detail-escape-pressed();
    callback back();
    callback large-preview-clicked();
    callback side-panel-close();
    callback grid-background-clicked();

    // ── Process panel (Task 14) ─────────────────────────────────────────────────
    // Toggled by `\` (backslash); surfaces background processing progress.
    in-out property <bool> process-panel-open: false;
    in property <string> process-running-state: "Idle";
    in property <int> previews-remaining: 0;
    in property <int> embeddings-remaining: 0;
    // Completion fractions (0.0..1.0) computed Rust-side from latched totals.
    in property <float> previews-fraction: 0.0;
    in property <float> embeddings-fraction: 0.0;
    in property <bool> process-paused: false;

    callback toggle-process-panel();
    callback process-pause-toggle();

    outer_focus := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.tile-enter-pressed();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.detail-escape-pressed();
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                root.toggle-bookmark();
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                if (root.side-panel-open) {
                    root.note-focus-pulse = !root.note-focus-pulse;
                }
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == "h" || event.text == "H") {
                root.gallery-nav("left", grid_pane.cols);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == "l" || event.text == "L") {
                root.gallery-nav("right", grid_pane.cols);
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == "k" || event.text == "K") {
                root.gallery-nav("up", grid_pane.cols);
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == "j" || event.text == "J") {
                root.gallery-nav("down", grid_pane.cols);
                return accept;
            }
            if (event.text == "\\") {
                // Suppress when the note editor has focus — let it type the
                // character.  note_input lives inside a conditional block so
                // its has-focus is mirrored via `note-editor-focused`.
                if (root.note-editor-focused) {
                    return reject;
                }
                root.toggle-process-panel();
                return accept;
            }
            return reject;
        }

    VerticalBox {
        HorizontalBox {
            Button {
                text: "← Cases";
                clicked => { root.back(); }
            }
            Button {
                text: "Select all";
                enabled: !root.indexing-active;
                clicked => { root.select-all(); }
            }
            Button {
                text: "Select none";
                enabled: !root.indexing-active;
                clicked => { root.select-none(); }
            }
            Button {
                text: root.filters-visible ? "Hide filters" : "Show filters";
                enabled: !root.indexing-active;
                clicked => { root.filters-toggle(); }
            }
            Rectangle {
                background: root.bookmarked-filter-enabled ? #cc6 : #555;
                opacity: root.indexing-active ? 0.5 : 1.0;
                border-radius: 12px;
                width: 130px;
                height: 28px;
                TouchArea {
                    enabled: !root.indexing-active;
                    clicked => { root.bookmarked-filter-toggle(); }
                }
                Text {
                    text: "Bookmarked";
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                background: root.hide-no-preview-enabled ? #cc6 : #555;
                opacity: root.indexing-active ? 0.5 : 1.0;
                border-radius: 12px;
                width: 150px;
                height: 28px;
                TouchArea {
                    enabled: !root.indexing-active;
                    clicked => { root.hide-no-preview-toggle(); }
                }
                Text {
                    text: "Hide no-preview";
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Spacer pushes sort controls to the right.
            Rectangle { horizontal-stretch: 1; }

            ComboBox {
                model: root.sort-key-items;
                current-index: root.sort-key-index;
                enabled: !root.indexing-active;
                selected(_) => { root.sort-key-changed(self.current-index); }
            }

            // Direction toggle button (↑ asc, ↓ desc)
            Rectangle {
                background: #555;
                opacity: root.indexing-active ? 0.5 : 1.0;
                border-radius: 4px;
                width: 28px;
                height: 28px;
                TouchArea {
                    enabled: !root.indexing-active;
                    clicked => { root.sort-dir-toggle(); }
                }
                Text {
                    text: root.sort-dir-asc ? "↑" : "↓";
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Bookmarked-first modifier toggle
            Rectangle {
                background: root.bookmarked-first-enabled ? #cc6 : #555;
                opacity: root.indexing-active ? 0.5 : 1.0;
                border-radius: 12px;
                width: 140px;
                height: 28px;
                TouchArea {
                    enabled: !root.indexing-active;
                    clicked => { root.bookmarked-first-toggle(); }
                }
                Text {
                    text: "★ Bookmarked first";
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if root.filters-visible: VerticalBox {
            padding: 0px;
            spacing: 4px;
            vertical-stretch: 0;
            if root.group-chips.length > 0: HorizontalBox {
                padding: 0px;
                for g in root.group-chips: Rectangle {
                    background: g.is_selected ? #3a6 : #555;
                    opacity: root.indexing-active ? 0.5 : 1.0;
                    border-radius: 12px;
                    width: 110px;
                    height: 28px;
                    TouchArea {
                        enabled: !root.indexing-active;
                        clicked => { root.group-tab-clicked(g.name); }
                    }
                    Text {
                        text: g.display_name + " (" + g.active_count + ")";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalBox {
                padding: 0px;
                for chip in root.chips: Rectangle {
                    background: chip.enabled
                        ? (chip.kind == "partial" ? #c66 : #3a6)
                        : #555;
                    opacity: root.indexing-active ? 0.5 : 1.0;
                    border-radius: 12px;
                    width: chip.kind == "partial" ? 130px : 90px;
                    height: 28px;
                    TouchArea {
                        enabled: !root.indexing-active;
                        clicked => { root.chip-toggled(chip.name); }
                    }
                    Text {
                        text: (chip.kind == "partial" ? "Partial " : "")
                            + (chip.display_name == "" ? chip.name : chip.display_name)
                            + " (" + chip.count + ")";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            if root.size-slider-visible: VerticalLayout {
                spacing: 2px;
                vertical-stretch: 0;
                opacity: root.indexing-active ? 0.5 : 1.0;
                HorizontalLayout {
                    height: 18px;
                    spacing: 4px;
                    Text {
                        text: "Size:";
                        color: white;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.size-range-label;
                        color: #aaa;
                        vertical-alignment: center;
                    }
                }
                RangeSlider {
                    lo: root.size-lo-norm;
                    hi: root.size-hi-norm;
                    enabled: !root.indexing-active;
                    range-changed(lo, hi) => {
                        root.size-lo-norm = lo;
                        root.size-hi-norm = hi;
                        root.size-range-changed(lo, hi);
                    }
                }
                HorizontalLayout {
                    height: 14px;
                    spacing: 4px;
                    Text {
                        text: "0 B";
                        color: #777;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.size-max-label;
                        color: #777;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        HorizontalBox {
            grid_pane := Rectangle {
                horizontal-stretch: 1;
                property <length> tile_w: 144px;
                property <length> tile_h: 168px;
                property <length> gap: 8px;
                property <length> tile-pitch-x: self.tile_w + self.gap;
                property <length> tile-pitch-y: self.tile_h + self.gap;
                // Reactive column count derived from the pane width. Used as
                // `cols` for the grid layout and reported up to Rust on each
                // change so the windowed-window-size math stays in sync.
                //
                // Both `init` and `changed` fire the callback: Slint's
                // `changed` only fires on transitions *after* the initial
                // binding evaluation, so without `init` the first computed
                // value (whatever the layout settles on for `self.width`)
                // would never propagate to `root.grid-cols` and the grid
                // would render in a single column until the user resized.
                property <int> cols: max(1, floor((self.width + self.gap) / self.tile-pitch-x));

                init => { root.grid-cols-changed(self.cols); }
                changed cols => { root.grid-cols-changed(self.cols); }

                clip: true;

                grid_flick := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: grid_pane.cols * grid_pane.tile-pitch-x;
                    // Task 14: virtual height covers the FULL filtered grid
                    // (`total-rows` × pitch), not just the in-window rows. This
                    // lets the user scroll through a 250k-row gallery while
                    // Rust slides the window of fetched FoundFiles underneath.
                    viewport-height: max(1, root.total-rows) * grid_pane.tile-pitch-y;

                    // Bind the Flickable's viewport-y up to the DetailPage's
                    // out property so Rust can poll the scroll position on
                    // each sync tick.
                    changed viewport-y => { root.grid-viewport-y = self.viewport-y; }

                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.grid-background-clicked();
                            outer_focus.focus();
                        }
                    }

                    for tile[i] in root.tiles: Rectangle {
                        // Task 14: position by absolute row/col baked into the
                        // tile, not by index-mod-cols. Tiles outside the
                        // current Rust-side window are simply absent; tiles
                        // present render at their true grid coordinate.
                        x: tile.absolute_col * grid_pane.tile-pitch-x;
                        y: tile.absolute_row * grid_pane.tile-pitch-y;
                        width: grid_pane.tile_w;
                        height: grid_pane.tile_h;
                        property <bool> is-selected: tile.id == root.selected-id;
                        border-width: is-selected || tile.is_bookmarked ? 2px : 1px;
                        border-color: is-selected
                            ? #3a6
                            : (tile.is_bookmarked
                                ? #cc6
                                : (tile_touch.has-hover ? #888 : #444));

                        // When this tile becomes the selected one (e.g. via j/k/h/l
                        // or arrow keys), nudge the Flickable so the whole tile is
                        // visible. Slint's viewport-y is 0 at the top and decreases
                        // as the user scrolls down.
                        changed is-selected => {
                            if (self.is-selected) {
                                if (self.y + grid_flick.viewport-y < 0) {
                                    grid_flick.viewport-y = -self.y;
                                } else if (self.y + self.height + grid_flick.viewport-y > grid_flick.height) {
                                    grid_flick.viewport-y = grid_flick.height - self.y - self.height;
                                }
                            }
                        }

                        tile_touch := TouchArea {
                            clicked => {
                                root.tile-clicked(tile.id);
                                outer_focus.focus();
                            }
                            double-clicked => {
                                root.tile-double-clicked(tile.id);
                            }

                            if tile.has_thumbnail: Image {
                                source: tile.thumbnail;
                                x: (parent.width - self.width) / 2;
                                y: 8px;
                                width: 128px;
                                height: 128px;
                                image-fit: contain;
                            }

                            Text {
                                x: 4px;
                                y: 140px;
                                width: parent.width - 8px;
                                text: tile.filename;
                                horizontal-alignment: center;
                                overflow: elide;
                                font-size: 11px;
                            }

                            Text {
                                x: 4px;
                                y: 154px;
                                width: parent.width - 8px;
                                text: tile.filesize + " - " + tile.file_type;
                                horizontal-alignment: center;
                                overflow: elide;
                                font-size: 10px;
                                color: #aaa;
                            }
                        }
                    }
                }

                if root.indexing-active: Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    background: #000000cc;
                    // Swallow clicks so tiles underneath are not interactive
                    // while the overlay is shown.
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        Text {
                            text: "Building index…";
                            color: white;
                            font-size: 18px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.indexing-files + " files indexed";
                            color: white;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            alignment: center;
                            ProgressIndicator {
                                progress: root.indexing-progress;
                                width: 280px;
                            }
                        }
                    }
                }
            }
            if root.process-panel-open: Rectangle {
                background: #1a1f2e;
                width: 220px;
                VerticalBox {
                    padding: 8px;
                    spacing: 6px;
                    // Header: title + close ×
                    HorizontalBox {
                        padding: 0px;
                        spacing: 4px;
                        Text {
                            text: "Background Jobs";
                            color: white;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        proc_close_touch := TouchArea {
                            width: 20px;
                            height: 20px;
                            clicked => { root.toggle-process-panel(); }
                            Rectangle {
                                background: proc_close_touch.has-hover ? #444 : transparent;
                                border-radius: 10px;
                                width: parent.width;
                                height: parent.height;
                                Text {
                                    // × is U+00D7 (Latin-1), glyph-safe per project conventions.
                                    text: "×";
                                    color: #aaa;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    // Previews row
                    HorizontalBox {
                        padding: 0px;
                        Text {
                            text: "Previews:";
                            color: #aaa;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.previews-remaining + " left";
                            color: white;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: #2a2a2a;
                        Rectangle {
                            x: 0;
                            y: 0;
                            height: parent.height;
                            width: parent.width * root.previews-fraction;
                            border-radius: parent.border-radius;
                            background: #3a6;
                        }
                    }
                    // Embeddings row
                    HorizontalBox {
                        padding: 0px;
                        Text {
                            text: "Embeddings:";
                            color: #aaa;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.embeddings-remaining + " left";
                            color: white;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: #2a2a2a;
                        Rectangle {
                            x: 0;
                            y: 0;
                            height: parent.height;
                            width: parent.width * root.embeddings-fraction;
                            border-radius: parent.border-radius;
                            background: #49f;
                        }
                    }
                    Rectangle { height: 4px; }
                    Text {
                        text: "State: " + root.process-running-state;
                        color: root.process-running-state == "Running" ? #3a6
                            : (root.process-running-state == "Paused" ? #cc6 : #888);
                        font-size: 11px;
                    }
                    // Pause/Resume: TouchArea not Button — avoids focus stealing.
                    proc_pause_touch := TouchArea {
                        height: 28px;
                        clicked => { root.process-pause-toggle(); }
                        Rectangle {
                            background: proc_pause_touch.has-hover ? #3a4a6a : #2a3a5a;
                            border-radius: 4px;
                            width: parent.width;
                            height: parent.height;
                            Text {
                                text: root.process-paused ? "Resume" : "Pause";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 12px;
                            }
                        }
                    }
                }
            }
            if root.side-panel-open: Rectangle {
                background: #1e1e1e;
                width: 320px;
                Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: parent.width;
                    VerticalBox {
                        // Filename row with bookmark star + + Note + close ✕
                        HorizontalBox {
                            LineEdit {
                                text: root.selected-filename;
                                read-only: true;
                                font-size: 16px;
                                horizontal-stretch: 1;
                            }
                            // Bookmark star toggle
                            bookmark_touch := TouchArea {
                                width: 28px;
                                height: 28px;
                                clicked => { root.toggle-bookmark(); }
                                Rectangle {
                                    background: root.selected-bookmarked ? #cc6 : #333;
                                    border-radius: 14px;
                                    width: parent.width;
                                    height: parent.height;
                                    Text {
                                        text: "★";
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 14px;
                                    }
                                }
                            }
                            // + Note button
                            note_btn_touch := TouchArea {
                                width: 56px;
                                height: 28px;
                                clicked => {
                                    note_input.focus();
                                }
                                Rectangle {
                                    background: #333;
                                    border-radius: 6px;
                                    width: parent.width;
                                    height: parent.height;
                                    Text {
                                        text: "+ Note";
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                    }
                                }
                            }
                            // Close ✕
                            close_touch := TouchArea {
                                width: 24px;
                                height: 24px;
                                clicked => {
                                    root.side-panel-close();
                                    outer_focus.focus();
                                }
                                Rectangle {
                                    background: close_touch.has-hover ? #444 : #333;
                                    border-radius: 12px;
                                    width: parent.width;
                                    height: parent.height;
                                    Text {
                                        text: "×";
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 16px;
                                    }
                                }
                            }
                        }

                        // Existing preview area
                        preview_touch := TouchArea {
                            height: 240px;
                            clicked => {
                                root.large-preview-clicked();
                                outer_focus.focus();
                            }
                            LargePreview {
                                width: parent.width;
                                height: parent.height;
                                has-image: root.selected-has-preview;
                                source-image: root.selected-preview;
                                caption: "(no preview)";
                            }
                        }

                        // Existing metadata rows
                        for row in root.selected-metadata: HorizontalBox {
                            Text {
                                text: row.key;
                                font-weight: 700;
                                color: white;
                            }
                            LineEdit {
                                text: row.value;
                                read-only: true;
                                horizontal-stretch: 1;
                            }
                        }

                        // Notes section
                        Text {
                            text: "Notes (" + root.selected-notes.length + ")";
                            color: #aaa;
                            font-size: 11px;
                        }
                        for note in root.selected-notes: Rectangle {
                            background: #2a2a2a;
                            border-radius: 3px;
                            min-height: 32px;
                            VerticalBox {
                                padding: 4px;
                                Text {
                                    text: note.at;
                                    color: #777;
                                    font-size: 9px;
                                }
                                TextEdit {
                                    text: note.text;
                                    read-only: true;
                                    wrap: word-wrap;
                                    font-size: 12px;
                                    min-height: 0;
                                }
                            }
                        }
                        Rectangle {
                            background: #111;
                            border-radius: 3px;
                            height: 80px;
                            note_input := TextEdit {
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                x: 4px;
                                y: 4px;
                                font-size: 12px;
                                wrap: word-wrap;
                                text: root.note-draft;
                                property <bool> focus-pulse: root.note-focus-pulse;
                                changed focus-pulse => { self.focus(); }
                                // Mirror focus state up so the outer FocusScope
                                // key handler can suppress `\` while typing notes.
                                changed has-focus => {
                                    root.note-editor-focused = self.has-focus;
                                }
                                edited => { root.note-draft = self.text; }
                                key-pressed(event) => {
                                    if (event.text == Key.Return
                                        && (event.modifiers.control || event.modifiers.meta)) {
                                        root.add-note(root.note-draft);
                                        // note-draft <- text via `edited`; the reverse is not automatic,
                                        // so clear both explicitly.
                                        root.note-draft = "";
                                        self.text = "";
                                        outer_focus.focus();
                                        return accept;
                                    }
                                    if (event.text == Key.Escape) {
                                        outer_focus.focus();
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                        HorizontalBox {
                            padding: 0px;
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Add";
                                enabled: root.note-draft != "";
                                clicked => {
                                    root.add-note(root.note-draft);
                                    root.note-draft = "";
                                    note_input.text = "";
                                    outer_focus.focus();
                                }
                            }
                        }

                        // Variants section (conditional)
                        if root.selected-has-variants: Text {
                            text: "Variants (" + root.selected-variants.length + ")";
                            color: #aaa;
                            font-size: 11px;
                        }
                        if root.selected-has-variants: Rectangle {
                            height: min(160px, ceil(root.selected-variants.length / 2) * 80px);
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                viewport-width: parent.width;
                                viewport-height: ceil(root.selected-variants.length / 2) * 80px;
                                for v[i] in root.selected-variants: Rectangle {
                                    x: mod(i, 2) * 145px;
                                    y: floor(i / 2) * 80px;
                                    width: 140px;
                                    height: 76px;
                                    background: v.is_best ? #444 : #2a2a2a;
                                    border-radius: 3px;
                                    border-width: v.is_best ? 2px : 0px;
                                    border-color: #ffd700;
                                    vt_touch := TouchArea {
                                        clicked => { root.variant-thumb-clicked(v.file_id); }
                                        double-clicked => { root.variant-thumb-double-clicked(v.file_id); }
                                        if v.has_thumbnail: Image {
                                            source: v.thumbnail;
                                            width: parent.width - 4px;
                                            height: parent.height - 18px;
                                            x: 2px;
                                            y: 2px;
                                            image-fit: contain;
                                        }
                                        Text {
                                            text: "#" + v.rank + (v.is_best ? " ★" : "");
                                            color: white;
                                            font-size: 10px;
                                            y: parent.height - 14px;
                                            x: 4px;
                                        }
                                    }
                                }
                            }
                        }
                        if root.selected-has-variants: Rectangle {
                            background: #2a4a6a;
                            border-radius: 3px;
                            height: 28px;
                            TouchArea {
                                clicked => { root.open-variant-viewer(); }
                                Text {
                                    text: "Open variant viewer";
                                    color: white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                        }

                        // Run Recovery button (conditional)
                        if root.recovery-button-visible: HorizontalBox {
                            Text {
                                text: "Keep:";
                                color: white;
                                vertical-alignment: center;
                            }
                            SpinBox {
                                value: root.keep-candidates;
                                minimum: 1;
                                maximum: 10;
                                edited(v) => { root.keep-candidates = v; }
                                enabled: root.recovery-button-enabled;
                            }
                            Button {
                                text: root.recovery-button-label;
                                enabled: root.recovery-button-enabled;
                                clicked => { root.run-recovery(); }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}
