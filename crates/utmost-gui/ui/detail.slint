import { HorizontalBox, VerticalBox, Button } from "std-widgets.slint";

export struct FilterChipData {
    name: string,
    enabled: bool,
    count: int,
}

export struct FileTileData {
    id: int,
    filename: string,
    filesize: string,
    file_type: string,
    has_thumbnail: bool,
    thumbnail: image,
}

export struct MetadataRow {
    key: string,
    value: string,
}

export component DetailPage inherits Rectangle {
    in-out property <[FilterChipData]> chips: [];
    in-out property <[FileTileData]> tiles: [];
    in-out property <string> sort-key: "Filename";
    in-out property <string> sort-dir: "Asc";

    in-out property <[MetadataRow]> selected-metadata: [];
    in-out property <bool> side-panel-open: false;
    in-out property <string> selected-filename: "";

    callback chip-toggled(string);
    callback select-all();
    callback select-none();
    callback tile-clicked(int);
    callback back();

    VerticalBox {
        HorizontalBox {
            Button {
                text: "Back";
                clicked => {
                    root.back();
                }
            }
            Button {
                text: "Select all";
                clicked => {
                    root.select-all();
                }
            }
            Button {
                text: "Select none";
                clicked => {
                    root.select-none();
                }
            }
            for chip in root.chips: Rectangle {
                background: chip.enabled ? #3a6 : #555;
                border-radius: 12px;
                width: 90px;
                height: 28px;
                TouchArea {
                    clicked => {
                        root.chip-toggled(chip.name);
                    }
                }
                Text {
                    text: chip.name + " (" + chip.count + ")";
                    color: white;
                }
            }
        }
        HorizontalBox {
            grid_pane := Rectangle {
                horizontal-stretch: 1;
                property <length> tile_w: 144px;
                property <length> tile_h: 168px;
                property <length> gap: 8px;
                property <int> cols: max(1, floor((self.width + self.gap) / (self.tile_w + self.gap)));
                property <int> row_count: ceil(root.tiles.length / max(1, self.cols));

                Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: grid_pane.cols * (grid_pane.tile_w + grid_pane.gap);
                    viewport-height: grid_pane.row_count * (grid_pane.tile_h + grid_pane.gap);

                    for tile[i] in root.tiles: Rectangle {
                        x: mod(i, grid_pane.cols) * (grid_pane.tile_w + grid_pane.gap);
                        y: floor(i / max(1, grid_pane.cols)) * (grid_pane.tile_h + grid_pane.gap);
                        width: grid_pane.tile_w;
                        height: grid_pane.tile_h;
                        border-width: 1px;
                        border-color: tile_touch.has-hover ? #888 : #444;

                        tile_touch := TouchArea {
                            clicked => {
                                root.tile-clicked(tile.id);
                            }

                            if tile.has_thumbnail: Image {
                                source: tile.thumbnail;
                                x: (parent.width - self.width) / 2;
                                y: 8px;
                                width: 128px;
                                height: 128px;
                                image-fit: contain;
                            }

                            Text {
                                x: 4px;
                                y: 140px;
                                width: parent.width - 8px;
                                text: tile.filename;
                                horizontal-alignment: center;
                                overflow: elide;
                                font-size: 11px;
                            }

                            Text {
                                x: 4px;
                                y: 154px;
                                width: parent.width - 8px;
                                text: tile.filesize + " - " + tile.file_type;
                                horizontal-alignment: center;
                                overflow: elide;
                                font-size: 10px;
                                color: #aaa;
                            }
                        }
                    }
                }
            }
            if root.side-panel-open: Rectangle {
                background: #1e1e1e;
                width: 280px;
                VerticalBox {
                    Text {
                        text: root.selected-filename;
                        font-size: 16px;
                        color: white;
                    }
                    for row in root.selected-metadata: HorizontalBox {
                        Text {
                            text: row.key;
                            font-weight: 700;
                            color: white;
                        }
                        Text {
                            text: row.value;
                            color: white;
                        }
                    }
                }
            }
        }
    }
}
